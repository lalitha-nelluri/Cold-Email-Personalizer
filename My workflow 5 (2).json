        "responses": {
          "values": [
            {
              "content": "=You are a company research assistant.\n\nAnalyze the website information below.\n\nCompany:\n{{ $(\"Company Details\").first().json.company_name }}\n\nWebsite:\n{{ $(\"Company Details\").first().json.website_url }}\n\nWebsite content:\n{{ $json.website_text }}\n\nIdentify ONLY information that is explicitly supported by the website content.\n\nLook for:\n1. Recent company achievements\n2. New product launches\n3. Awards\n4. Partnerships\n5. Expansion\n6. Important announcements\n\nReturn:\n\nRecent Update:\nSource Evidence:\nWhy It Is Relevant:\n\nIf there is no reliable recent information, say:\n\"No reliable recent information found.\"\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
