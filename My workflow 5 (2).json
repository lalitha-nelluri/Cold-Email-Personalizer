    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst text = JSON.stringify(input)\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, \"\")\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, \"\")\n  .replace(/<[^>]+>/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nreturn [\n  {\n    json: {\n      company_name: $(\"Company Details\").first().json.company_name,\n      website_url: $(\"Company Details\").first().json.website_url,\n      prospect_name: $(\"Company Details\").first().json.prospect_name,\n      website_text: text.substring(0, 15000)\n    }\n  }\n];\n"
      },
